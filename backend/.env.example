# ============================================
# EduSphere — Backend Configuration Template
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# ⚠️  NEVER commit your .env file to version control!

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Default Admin Credentials (created on first startup)
ADMIN_EMAIL=admin@yourschool.edu.in
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Cloudinary Media Storage (optional — falls back to local disk)
# Sign up at https://cloudinary.com (free 25 GB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=your_school_name

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5500

# Production domain (for CSP headers and CORS)
PRODUCTION_DOMAIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
FORM_RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=debug
REQUEST_TIMEOUT_MS=30000
CACHE_MAX_AGE=300

# Upload paths (optional — defaults to ./uploads in development)
# UPLOAD_DIR=/var/www/uploads
# UPLOAD_URL=https://yourdomain.com/uploads

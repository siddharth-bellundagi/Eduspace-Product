{
  "name": "edusphere-backend",
  "version": "2.0.0",
  "description": "EduSphere — School/College Management Backend API — Node.js + Express + SQLite + Cloudinary",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:api": "node scripts/test-endpoints.js",
    "setup-db": "node scripts/setup-db.js",
    "start:prod": "NODE_ENV=production pm2 start ecosystem.config.js --env production",
    "start:staging": "NODE_ENV=staging pm2 start ecosystem.config.js --env staging",
    "stop": "pm2 stop edusphere-backend",
    "restart": "pm2 restart edusphere-backend",
    "logs": "pm2 logs edusphere-backend",
    "health": "curl -s http://localhost:5000/api/health | node -e \"process.stdin.resume(); process.stdin.on('data', d => console.log(JSON.stringify(JSON.parse(d), null, 2)))\"",
    "setup-admin": "node scripts/setup-admin.js",
    "reset-password": "node scripts/reset-password.js"
  },
  "keywords": [
    "school",
    "college",
    "edusphere",
    "backend",
    "express"
  ],
  "author": "EduSphere Technologies",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^6.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
